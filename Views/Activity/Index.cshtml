@model List<CloudStorage.Models.ActivityLog>
@{
    ViewData["Title"] = "Activity Feed";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-history me-2"></i>Activity Feed</h2>
        <div>
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
                <i class="fas fa-filter me-2"></i>Filters
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="collapse mb-4" id="filterSection">
        <div class="card">
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="fromDate" class="form-label">From Date</label>
                            <input type="date" class="form-control" id="fromDate" name="fromDate" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label for="toDate" class="form-label">To Date</label>
                            <input type="date" class="form-control" id="toDate" name="toDate" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-4">
                            <label for="activityType" class="form-label">Activity Type</label>
                            <select class="form-select" id="activityType" name="activityType">
                                <option value="">All Types</option>
                                @foreach (var type in (Array)ViewBag.ActivityTypes)
                                {
                                    <option value="@type" selected="@(ViewBag.ActivityType?.ToString() == type.ToString())">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Filter
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Activity List -->
    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;"><i class="fas fa-circle-notch"></i></th>
                                <th>Activity</th>
                                <th>File</th>
                                <th>User</th>
                                <th>Time</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @switch (activity.ActivityType)
                                        {
                                            case CloudStorage.Models.ActivityType.FileUploaded:
                                                <i class="fas fa-upload text-success" title="Uploaded"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.FileDownloaded:
                                                <i class="fas fa-download text-primary" title="Downloaded"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.FileViewed:
                                                <i class="fas fa-eye text-info" title="Viewed"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.FileEdited:
                                                <i class="fas fa-edit text-warning" title="Edited"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.FileDeleted:
                                                <i class="fas fa-trash text-danger" title="Deleted"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.FileShared:
                                                <i class="fas fa-share-alt text-primary" title="Shared"></i>
                                                break;
                                            case CloudStorage.Models.ActivityType.CommentAdded:
                                                <i class="fas fa-comment text-success" title="Comment Added"></i>
                                                break;
                                            default:
                                                <i class="fas fa-circle text-secondary"></i>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <strong>@activity.ActivityType.ToString().Replace("File", "").Replace("Folder", "")</strong>
                                    </td>
                                    <td>
                                        @if (activity.StorageItem != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                @if (activity.StorageItem.Type == CloudStorage.Models.StorageItemType.Folder)
                                                {
                                                    <i class="fas fa-folder text-warning me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-file text-secondary me-2"></i>
                                                }
                                                <span>@activity.StorageItem.Name</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (activity.User != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-2">
                                                    @activity.User.FirstName?.Substring(0, 1).ToUpper()@activity.User.LastName?.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div>@activity.User.FirstName @activity.User.LastName</div>
                                                    <small class="text-muted">@activity.User.Email</small>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div>@activity.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@activity.Timestamp.ToLocalTime().ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(activity.Description))
                                        {
                                            <small class="text-muted">@activity.Description</small>
                                        }
                                        @if (!string.IsNullOrEmpty(activity.AdditionalData))
                                        {
                                            <br />
                                            <small class="badge bg-secondary">@activity.AdditionalData</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Activity pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate&activityType=@ViewBag.ActivityType">Previous</a>
                    </li>
                    
                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate&activityType=@ViewBag.ActivityType">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate&activityType=@ViewBag.ActivityType">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-history fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No Activity Found</h4>
                <p class="text-muted">Try adjusting your filters or upload some files to get started.</p>
            </div>
        </div>
    }
</div>

<style>
    .avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
    }
</style>
