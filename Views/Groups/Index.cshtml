@model List<CloudStorage.Models.Group>
@{
    ViewData["Title"] = "My Groups";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> My Groups</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Group
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3">No Groups Yet</h4>
            <p class="text-muted">Create a group to organize your contacts and share files with multiple people at once.</p>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle"></i> Create Your First Group
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var group in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-people-fill text-primary"></i> @group.Name
                            </h5>
                            
                            @if (!string.IsNullOrEmpty(group.Description))
                            {
                                <p class="card-text text-muted small">@group.Description</p>
                            }
                            
                            <div class="mb-3">
                                <span class="badge bg-secondary">
                                    <i class="bi bi-person"></i> @group.Members.Count member@(group.Members.Count != 1 ? "s" : "")
                                </span>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="ManageMembers" asp-route-id="@group.Id" class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-person-plus"></i> Manage
                                </a>
                                <a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="confirmDelete(@group.Id, '@group.Name')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-footer text-muted small">
                            <i class="bi bi-clock"></i> Created @group.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the group "<span id="groupNameToDelete"></span>"?</p>
                <p class="text-danger"><strong>Warning:</strong> This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Group</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(groupId, groupName) {
            document.getElementById('groupNameToDelete').textContent = groupName;
            document.getElementById('deleteForm').action = '/Groups/Delete/' + groupId;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}
