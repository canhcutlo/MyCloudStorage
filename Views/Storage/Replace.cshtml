@model CloudStorage.Models.ViewModels.ReplaceFileViewModel
@{
    ViewData["Title"] = "Replace File";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-arrow-repeat"></i> Replace File
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Current File:</strong> @Model.ItemName
                        <br>
                        <small>The current version will be saved in version history before being replaced.</small>
                    </div>

                    <form asp-action="Replace" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ItemId)
                        @Html.HiddenFor(m => m.ItemName)
                        @Html.HiddenFor(m => m.ParentFolderId)

                        <div class="mb-3">
                            <label asp-for="File" class="form-label">
                                <i class="bi bi-file-earmark-arrow-up"></i> Select New File
                            </label>
                            <input asp-for="File" class="form-control" type="file" required />
                            <span asp-validation-for="File" class="text-danger"></span>
                            <div class="form-text">
                                Choose the file that will replace the current one.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangeDescription" class="form-label">
                                <i class="bi bi-chat-text"></i> Change Description
                            </label>
                            <textarea asp-for="ChangeDescription" 
                                      class="form-control" 
                                      rows="3" 
                                      placeholder="Optional: Describe what changed in this version..."></textarea>
                            <span asp-validation-for="ChangeDescription" class="text-danger"></span>
                            <div class="form-text">
                                This description will be saved with the version history.
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Important:</strong>
                            <ul class="mb-0 mt-2">
                                <li>The current file will be backed up automatically</li>
                                <li>You can restore previous versions from version history</li>
                                <li>File size will affect your storage quota</li>
                            </ul>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" asp-route-folderId="@Model.ParentFolderId" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-arrow-repeat"></i> Replace File
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
