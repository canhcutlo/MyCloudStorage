                                    <td><kbd>Ctrl</kbd> + <kbd>N</kbd></td>
                                    <td>Create new folder</td>
                                </tr>
                                <tr>
                                    <td><kbd>Delete</kbd></td>
                                    <td>Delete selected items</td>
