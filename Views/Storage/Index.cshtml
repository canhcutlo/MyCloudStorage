@model CloudStorage.Models.ViewModels.StorageViewModel
@{
    ViewData["Title"] = "My Storage";
    var breadcrumbs = ViewBag.Breadcrumbs as IEnumerable<CloudStorage.Models.StorageItem> ?? new List<CloudStorage.Models.StorageItem>();
    var currentFolderId = ViewBag.CurrentFolderId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    @if (Model.CanEditCurrentFolder)
    {
        <div class="btn-group">
            <a asp-action="Upload" asp-route-folderId="@currentFolderId" class="btn btn-primary">
                <i class="fas fa-upload"></i> Upload File
            </a>
            <a asp-action="CreateFolder" asp-route-parentFolderId="@currentFolderId" class="btn btn-success">
                <i class="fas fa-folder-plus"></i> New Folder
            </a>
            <a asp-action="AICreateFolder" asp-route-parentFolderId="@currentFolderId" class="btn btn-info text-white">
                <i class="bi bi-robot"></i> AI Create
            </a>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#keyboardShortcutsModal" title="Keyboard Shortcuts (F1 or ?)">
                <i class="fas fa-keyboard"></i>
            </button>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2">
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle"></i> Viewing shared folder (Read-only)
            </div>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#keyboardShortcutsModal" title="Keyboard Shortcuts (F1 or ?)">
                <i class="fas fa-keyboard"></i>
            </button>
        </div>
    }
</div>

<!-- Storage Usage -->
<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <h6 class="text-muted">Storage Used</h6>
                        <h4>@Math.Round(Model.TotalUsedStorage / 1024.0 / 1024.0, 2) MB</h4>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Storage Quota</h6>
                        <h4>@Math.Round(Model.TotalStorageQuota / 1024.0 / 1024.0, 2) MB</h4>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Files</h6>
                        <h4>@Model.TotalFiles</h4>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Folders</h6>
                        <h4>@Model.TotalFolders</h4>
                    </div>
                </div>
                <div class="progress mt-3">
                    <div class="progress-bar" style="width: @(Model.TotalStorageQuota > 0 ? (Model.TotalUsedStorage * 100.0 / Model.TotalStorageQuota) : 0)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Breadcrumb Navigation -->
@if (breadcrumbs.Any() || currentFolderId.HasValue)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index"><i class="fas fa-home"></i> Home</a>
            </li>
            @foreach (var folder in breadcrumbs)
            {
                <li class="breadcrumb-item">
                    <a asp-action="Index" asp-route-folderId="@folder.Id">
                        @folder.Name
                        @if (folder.Shares != null && folder.Shares.Any(s => s.IsActive))
                        {
                            <i class="fas fa-share-alt text-info ms-1" title="Shared folder"></i>
                        }
                    </a>
                </li>
            }
        </ol>
    </nav>
    @if (Model.CurrentFolder != null && !Model.CanEditCurrentFolder)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You are viewing a shared folder with @(Model.ItemEditPermissions.Any(kvp => kvp.Value) ? "Editor" : "Viewer") permissions.
        </div>
    }
}

<!-- Search Bar and Sorting -->
<div class="row mb-3">
    <div class="col-md-4">
        <form asp-action="Search" method="get">
            <div class="input-group">
                <input type="text" name="query" class="form-control" placeholder="Search files and folders...">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <label class="input-group-text bg-light"><i class="fas fa-sort me-1"></i> Sort by</label>
            <select id="sortSelect" class="form-select" onchange="applySorting()">
                <option value="name-asc" selected="@(ViewBag.SortBy == "name" && ViewBag.SortOrder == "asc")"> Name (A-Z)</option>
                <option value="name-desc" selected="@(ViewBag.SortBy == "name" && ViewBag.SortOrder == "desc")"> Name (Z-A)</option>
                <option value="date-desc" selected="@(ViewBag.SortBy == "date" && ViewBag.SortOrder == "desc")"> Date (Newest First)</option>
                <option value="date-asc" selected="@(ViewBag.SortBy == "date" && ViewBag.SortOrder == "asc")"> Date (Oldest First)</option>
                <option value="size-asc" selected="@(ViewBag.SortBy == "size" && ViewBag.SortOrder == "asc")"> Size (Smallest First)</option>
                <option value="size-desc" selected="@(ViewBag.SortBy == "size" && ViewBag.SortOrder == "desc")"> Size (Largest First)</option>
            </select>
        </div>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Favorites" class="btn btn-outline-warning me-2">
            <i class="fas fa-star"></i> Favorites
        </a>
        <a asp-action="SharedItems" class="btn btn-outline-primary">
            <i class="fas fa-share-alt"></i> Shared Items
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["PublicShareUrl"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        <strong>Public Share URL:</strong>
        <div class="input-group mt-2">
            <input type="text" class="form-control" value="@TempData["PublicShareUrl"]" readonly id="shareUrl">
            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard()">Copy</button>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Drag and Drop Upload Zone -->
@if (Model.CanEditCurrentFolder)
{
    <div id="dropZone" class="drop-zone mb-3">
        <div class="drop-zone-content">
            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
            <h5>Drag & Drop Files Here</h5>
            <p class="text-muted">or click to browse</p>
            <input type="file" id="fileInput" multiple hidden />
        </div>
        <div id="uploadProgress" class="upload-progress" style="display:none;">
            <div class="progress mb-2">
                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"></div>
            </div>
            <small id="uploadStatus" class="text-muted"></small>
        </div>
    </div>
}

<!-- Bulk Actions Toolbar -->
<div id="bulkActionsToolbar" class="bulk-actions-toolbar mb-3" style="display:none;">
    <div class="card">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong id="selectedCount">0</strong> items selected
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-primary" onclick="bulkDownload()">
                        <i class="fas fa-download"></i> Download
                    </button>
                    <button type="button" class="btn btn-sm btn-warning" onclick="showBulkMoveModal()">
                        <i class="fas fa-folder"></i> Move
                    </button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="bulkDelete()">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="clearSelection()">
                        <i class="fas fa-times"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- File/Folder List -->
<div class="card">
    <div class="card-body">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            @if (Model.CanEditCurrentFolder)
                            {
                                <th style="width: 40px;">
                                    <input type="checkbox" id="selectAll" class="form-check-input" onchange="toggleSelectAll(this)" />
                                </th>
                            }
                            <th>Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Modified</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="item-row" data-item-id="@item.Id" data-item-type="@item.Type">
                                @if (Model.CanEditCurrentFolder)
                                {
                                    <td>
                                        <input type="checkbox" class="form-check-input item-checkbox" value="@item.Id" onchange="updateBulkActions()" />
                                    </td>
                                }
                                <td>
                                    @if (item.Type == CloudStorage.Models.StorageItemType.Folder)
                                    {
                                        <a asp-action="Index" asp-route-folderId="@item.Id" class="text-decoration-none">
                                            <i class="fas fa-folder text-warning me-2"></i>@item.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <i class="fas fa-file text-primary me-2"></i>@item.Name
                                    }
                                    
                                    @if (item.Shares != null && item.Shares.Any(s => s.IsActive))
                                    {
                                        <i class="fas fa-share-alt text-info ms-2" title="Shared"></i>
                                    }
                                </td>
                                <td>
                                    @if (item.Type == CloudStorage.Models.StorageItemType.Folder)
                                    {
                                        <span class="badge bg-secondary">Folder</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">File</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Type == CloudStorage.Models.StorageItemType.File)
                                    {
                                        @Math.Round(item.Size / 1024.0 / 1024.0, 2) <text>MB</text>
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td>@item.ModifiedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @{
                                        var canEdit = Model.ItemEditPermissions.GetValueOrDefault(item.Id, false);
                                        var isFavorite = Model.ItemFavoriteStatuses.GetValueOrDefault(item.Id, false);
                                    }
                                    
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenu@(item.Id)" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu@(item.Id)">
                                            @if (item.Type == CloudStorage.Models.StorageItemType.File)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Preview" asp-action="Document" asp-route-id="@item.Id">
                                                        <i class="fas fa-eye text-info me-2"></i>Preview
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-action="Download" asp-route-id="@item.Id">
                                                        <i class="fas fa-download text-primary me-2"></i>Download
                                                    </a>
                                                </li>
                                                
                                                @inject CloudStorage.Services.IFileStorageService FileStorageService
                                                @if (canEdit)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Version" asp-action="History" asp-route-id="@item.Id">
                                                            <i class="fas fa-clock-rotate-left text-info me-2"></i>Version History
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-action="Replace" asp-route-id="@item.Id">
                                                            <i class="fas fa-arrow-rotate-left text-warning me-2"></i>Replace File
                                                        </a>
                                                    </li>
                                                }
                                                @if (canEdit && FileStorageService.IsEditableTextFile(item.Name))
                                                {
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Preview" asp-action="Edit" asp-route-id="@item.Id">
                                                            <i class="fas fa-edit text-dark me-2"></i>Edit
                                                        </a>
                                                    </li>
                                                }
                                                <li><hr class="dropdown-divider"></li>
                                            }
                                            
                                            <li>
                                                <form asp-action="ToggleFavorite" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="currentFolderId" value="@currentFolderId" />
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="@(isFavorite ? "fas" : "far") fa-star text-warning me-2"></i>@(isFavorite ? "Remove from Favorites" : "Add to Favorites")
                                                    </button>
                                                </form>
                                            </li>
                                            
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0);" onclick="openShareModal(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                                    <i class="fas fa-share-alt text-success me-2"></i>Share
                                                </a>
                                            </li>
                                            
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0);" onclick="openCommentsModal(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                                    <i class="fas fa-comments text-info me-2"></i>Comments
                                                </a>
                                            </li>
                                            
                                            @if (canEdit)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item" asp-action="Rename" asp-route-id="@item.Id">
                                                        <i class="fas fa-pen text-secondary me-2"></i>Rename
                                                    </a>
                                                </li>
                                                <li>
                                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="currentFolderId" value="@currentFolderId" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="fas fa-trash me-2"></i>Delete
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">This folder is empty</h5>
                <p class="text-muted">@(Model.CanEditCurrentFolder ? "Upload files or create folders to get started." : "This shared folder is currently empty.")</p>
                
                @if (Model.CanEditCurrentFolder)
                {
                    <div class="mt-3">
                        <a asp-action="Upload" asp-route-folderId="@currentFolderId" class="btn btn-primary me-2">
                            <i class="fas fa-upload"></i> Upload File
                        </a>
                        <a asp-action="CreateFolder" asp-route-parentFolderId="@currentFolderId" class="btn btn-success">
                            <i class="fas fa-folder-plus"></i> New Folder
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard() {
            const shareUrl = document.getElementById('shareUrl');
            shareUrl.select();
            shareUrl.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(shareUrl.value);
            
            const button = event.target;
            const originalText = button.textContent;
            button.textContent = 'Copied!';
            setTimeout(() => {
                button.textContent = originalText;
            }, 2000);
        }

        function applySorting() {
            const sortSelect = document.getElementById('sortSelect');
            const selectedValue = sortSelect.value;
            const [sortBy, sortOrder] = selectedValue.split('-');
            
            const currentFolderId = '@ViewBag.CurrentFolderId';
            const url = new URL(window.location.href);
            url.searchParams.set('sortBy', sortBy);
            url.searchParams.set('sortOrder', sortOrder);
            
            if (currentFolderId) {
                url.searchParams.set('folderId', currentFolderId);
            }
            
            window.location.href = url.toString();
        }

        // Set selected option on page load
        document.addEventListener('DOMContentLoaded', function() {
            const sortBy = '@ViewBag.SortBy' || 'name';
            const sortOrder = '@ViewBag.SortOrder' || 'asc';
            const sortSelect = document.getElementById('sortSelect');
            sortSelect.value = sortBy + '-' + sortOrder;
        });

        // Open comments modal
        function openCommentsModal(itemId, itemName) {
            const modal = new bootstrap.Modal(document.getElementById('commentsModal'));
            document.getElementById('commentsModalLabel').textContent = 'Comments - ' + itemName;
            document.getElementById('commentsModalContent').innerHTML = '<div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>';
            modal.show();

            // Load comments
            fetch(`@Url.Action("GetComments", "Storage")?itemId=${itemId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        renderComments(data.comments, itemId);
                    } else {
                        document.getElementById('commentsModalContent').innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                    }
                })
                .catch(error => {
                    console.error('Error loading comments:', error);
                    document.getElementById('commentsModalContent').innerHTML = '<div class="alert alert-danger">Error loading comments</div>';
                });
        }

        function renderComments(comments, itemId) {
            let html = `
                <div class="mb-3">
                    <form id="addCommentForm" onsubmit="addComment(event, ${itemId})">
                        <textarea class="form-control" id="newCommentText" rows="3" placeholder="Write a comment..." required></textarea>
                        <button type="submit" class="btn btn-primary mt-2"><i class="fas fa-paper-plane me-1"></i>Add Comment</button>
                    </form>
                </div>
                <hr>
            `;

            if (comments.length === 0) {
                html += '<div class="text-center text-muted py-4"><i class="fas fa-comments fa-3x mb-3"></i><p>No comments yet. Be the first to comment!</p></div>';
            } else {
                comments.forEach(comment => {
                    html += `
                        <div class="comment-item mb-3 p-3 border rounded" style="background-color: #f8f9fa;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div><strong>${comment.userName}</strong> <small class="text-muted">${comment.createdAt}</small>${comment.modifiedAt ? ' <small class="text-muted">(edited)</small>' : ''}</div>
                                ${comment.isOwner ? `
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="javascript:void(0);" onclick="editCommentInline(${comment.id}, '${comment.text.replace(/'/g, "\\'")}')"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                            <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteCommentInline(${comment.id})"><i class="fas fa-trash me-2"></i>Delete</a></li>
                                        </ul>
                                    </div>
                                ` : ''}
                            </div>
                            <p class="mt-2 mb-2">${comment.text}</p>
                    `;

                    if (comment.replies && comment.replies.length > 0) {
                        html += '<div class="ms-4 mt-2">';
                        comment.replies.forEach(reply => {
                            html += `
                                <div class="reply-item mb-2 p-2 border-start border-3 border-primary">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div><strong>${reply.userName}</strong> <small class="text-muted">${reply.createdAt}</small></div>
                                        ${reply.isOwner ? `
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="javascript:void(0);" onclick="editCommentInline(${reply.id}, '${reply.text.replace(/'/g, "\\'")}')"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                    <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteCommentInline(${reply.id})"><i class="fas fa-trash me-2"></i>Delete</a></li>
                                                </ul>
                                            </div>
                                        ` : ''}
                                    </div>
                                    <p class="mt-1 mb-0">${reply.text}</p>
                                </div>
                            `;
                        });
                        html += '</div>';
                    }

                    html += '</div>';
                });
            }

            document.getElementById('commentsModalContent').innerHTML = html;
        }

        async function addComment(event, itemId) {
            event.preventDefault();
            const commentText = document.getElementById('newCommentText').value;
            
            const formData = new FormData();
            formData.append('itemId', itemId);
            formData.append('commentText', commentText);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("AddComment", "Storage")', { method: 'POST', body: formData });
                const result = await response.json();
                
                if (result.success) {
                    openCommentsModal(itemId, '');
                    document.getElementById('commentsModalLabel').textContent = document.getElementById('commentsModalLabel').textContent;
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred');
            }
        }

        async function editCommentInline(commentId, currentText) {
            const newText = prompt('Edit comment:', currentText);
            if (!newText || newText.trim() === currentText) return;

            const formData = new FormData();
            formData.append('commentId', commentId);
            formData.append('commentText', newText.trim());
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("UpdateComment", "Storage")', { method: 'POST', body: formData });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred');
            }
        }

        async function deleteCommentInline(commentId) {
            if (!confirm('Are you sure you want to delete this comment?')) return;

            const formData = new FormData();
            formData.append('commentId', commentId);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("DeleteComment", "Storage")', { method: 'POST', body: formData });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred');
            }
        }

        // Drag and Drop Upload
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const uploadProgress = document.getElementById('uploadProgress');
        const uploadProgressBar = document.getElementById('uploadProgressBar');
        const uploadStatus = document.getElementById('uploadStatus');

        if (dropZone && fileInput) {
            dropZone.addEventListener('click', () => fileInput.click());
            
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('drag-over');
            });
            
            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('drag-over');
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    uploadFiles(files);
                }
            });
            
            fileInput.addEventListener('change', (e) => {
                const files = e.target.files;
                if (files.length > 0) {
                    uploadFiles(files);
                }
            });
        }

        async function uploadFiles(files) {
            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('files', files[i]);
            }
            formData.append('folderId', '@currentFolderId' || '');

            uploadProgress.style.display = 'block';
            dropZone.querySelector('.drop-zone-content').style.display = 'none';
            uploadStatus.textContent = `Uploading ${files.length} file(s)...`;
            uploadProgressBar.style.width = '0%';

            try {
                const xhr = new XMLHttpRequest();
                
                xhr.upload.addEventListener('progress', (e) => {
                    if (e.lengthComputable) {
                        const percentComplete = (e.loaded / e.total) * 100;
                        uploadProgressBar.style.width = percentComplete + '%';
                        uploadProgressBar.textContent = Math.round(percentComplete) + '%';
                    }
                });

                xhr.addEventListener('load', () => {
                    if (xhr.status === 200) {
                        const result = JSON.parse(xhr.responseText);
                        if (result.success) {
                            uploadStatus.textContent = `Successfully uploaded ${result.uploadedCount} file(s)!`;
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            uploadStatus.textContent = 'Upload completed with errors';
                            if (result.errors && result.errors.length > 0) {
                                alert('Errors:\\n' + result.errors.join('\\n'));
                            }
                            setTimeout(() => {
                                uploadProgress.style.display = 'none';
                                dropZone.querySelector('.drop-zone-content').style.display = 'block';
                            }, 3000);
                        }
                    }
                });

                xhr.open('POST', '@Url.Action("UploadMultiple", "Storage")');
                xhr.send(formData);

            } catch (error) {
                console.error('Upload error:', error);
                uploadStatus.textContent = 'Upload failed';
                setTimeout(() => {
                    uploadProgress.style.display = 'none';
                    dropZone.querySelector('.drop-zone-content').style.display = 'block';
                }, 3000);
            }
        }

        // Bulk Operations
        function toggleSelectAll(checkbox) {
            const itemCheckboxes = document.querySelectorAll('.item-checkbox');
            itemCheckboxes.forEach(cb => cb.checked = checkbox.checked);
            updateBulkActions();
        }

        function updateBulkActions() {
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            const bulkToolbar = document.getElementById('bulkActionsToolbar');
            const selectedCount = document.getElementById('selectedCount');
            
            if (selectedCheckboxes.length > 0) {
                bulkToolbar.style.display = 'block';
                selectedCount.textContent = selectedCheckboxes.length;
            } else {
                bulkToolbar.style.display = 'none';
                document.getElementById('selectAll').checked = false;
            }
        }

        function getSelectedIds() {
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            return Array.from(selectedCheckboxes).map(cb => parseInt(cb.value));
        }

        function clearSelection() {
            document.querySelectorAll('.item-checkbox').forEach(cb => cb.checked = false);
            document.getElementById('selectAll').checked = false;
            updateBulkActions();
        }

        async function bulkDelete() {
            const itemIds = getSelectedIds();
            if (itemIds.length === 0) return;

            if (!confirm(`Are you sure you want to delete ${itemIds.length} item(s)?`)) return;

            const formData = new FormData();
            itemIds.forEach(id => formData.append('itemIds', id));
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("BulkDelete", "Storage")', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to delete items');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while deleting items');
            }
        }

        async function bulkDownload() {
            const itemIds = getSelectedIds();
            if (itemIds.length === 0) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("BulkDownload", "Storage")';
            
            itemIds.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'itemIds';
                input.value = id;
                form.appendChild(input);
            });
            
            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

        function showBulkMoveModal() {
            const itemIds = getSelectedIds();
            if (itemIds.length === 0) return;

            const targetFolderId = prompt('Enter target folder ID (leave empty for root):');
            if (targetFolderId === null) return;

            bulkMove(itemIds, targetFolderId === '' ? null : parseInt(targetFolderId));
        }

        async function bulkMove(itemIds, targetFolderId) {
            const formData = new FormData();
            itemIds.forEach(id => formData.append('itemIds', id));
            if (targetFolderId !== null) {
                formData.append('targetFolderId', targetFolderId);
            }
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("BulkMove", "Storage")', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to move items');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while moving items');
            }
        }

        // ============================================
        // Keyboard Shortcuts
        // ============================================
        
        let selectedItemIndex = -1;
        const itemRows = [];

        function initializeKeyboardShortcuts() {
            // Build array of selectable items
            document.querySelectorAll('.item-checkbox').forEach((checkbox, index) => {
                itemRows.push({
                    checkbox: checkbox,
                    row: checkbox.closest('tr'),
                    itemId: parseInt(checkbox.value)
                });
            });

            document.addEventListener('keydown', handleKeyboardShortcut);
            
            // Show keyboard shortcuts help on initial load (once)
            if (!localStorage.getItem('keyboardShortcutsShown')) {
                setTimeout(() => {
                    const helpBtn = document.querySelector('[data-bs-target="#keyboardShortcutsModal"]');
                    if (helpBtn) {
                        const helpText = document.createElement('div');
                        helpText.className = 'alert alert-info alert-dismissible fade show position-fixed bottom-0 end-0 m-3';
                        helpText.style.zIndex = '9999';
                        helpText.innerHTML = `
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            <strong><i class="fas fa-keyboard me-2"></i>Tip:</strong> Press <kbd>?</kbd> or <kbd>F1</kbd> to view keyboard shortcuts!
                        `;
                        document.body.appendChild(helpText);
                        setTimeout(() => helpText.remove(), 8000);
                        localStorage.setItem('keyboardShortcutsShown', 'true');
                    }
                }, 1000);
            }
        }

        function handleKeyboardShortcut(e) {
            // Don't trigger shortcuts when typing in inputs, textareas, or contenteditable elements
            const target = e.target;
            if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {
                return;
            }

            // Ctrl/Cmd shortcuts
            if (e.ctrlKey || e.metaKey) {
                switch(e.key.toLowerCase()) {
                    case 'a': // Select All
                        e.preventDefault();
                        selectAllItems();
                        break;
                    case 'd': // Deselect All
                        e.preventDefault();
                        deselectAllItems();
                        break;
                    case 'u': // Upload
                        e.preventDefault();
                        document.getElementById('fileInput')?.click();
                        break;
                    case 'n': // New Folder
                        e.preventDefault();
                        document.querySelector('[data-bs-target="#createFolderModal"]')?.click();
                        break;
                    case 'f': // Focus Search
                        e.preventDefault();
                        document.querySelector('input[name="searchQuery"]')?.focus();
                        break;
                    case 'r': // Refresh
                        e.preventDefault();
                        location.reload();
                        break;
                }

                // Ctrl+Shift shortcuts
                if (e.shiftKey) {
                    switch(e.key.toLowerCase()) {
                        case 'd': // Bulk Download
                            e.preventDefault();
                            if (getSelectedIds().length > 0) {
                                document.getElementById('bulkDownloadBtn')?.click();
                            }
                            break;
                        case 'm': // Bulk Move
                            e.preventDefault();
                            if (getSelectedIds().length > 0) {
                                document.getElementById('bulkMoveBtn')?.click();
                            }
                            break;
                    }
                }
            }

            // Non-modifier shortcuts
            switch(e.key) {
                case 'Delete': // Delete selected items
                    if (getSelectedIds().length > 0) {
                        e.preventDefault();
                        document.getElementById('bulkDeleteBtn')?.click();
                    }
                    break;
                case 'F1': // Show keyboard shortcuts help
                case '?':
                    e.preventDefault();
                    showKeyboardShortcuts();
                    break;
                case 'Escape': // Clear selection / Close modals
                    e.preventDefault();
                    deselectAllItems();
                    // Close any open Bootstrap modals
                    document.querySelectorAll('.modal.show').forEach(modal => {
                        bootstrap.Modal.getInstance(modal)?.hide();
                    });
                    break;
                case 'Backspace': // Go to parent folder
                    if (!e.ctrlKey && !e.shiftKey) {
                        e.preventDefault();
                        const backButton = document.querySelector('a[href*="parentId="]');
                        if (backButton) {
                            backButton.click();
                        }
                    }
                    break;
                case 'ArrowDown': // Navigate down
                    e.preventDefault();
                    navigateItems(1);
                    break;
                case 'ArrowUp': // Navigate up
                    e.preventDefault();
                    navigateItems(-1);
                    break;
                case 'Enter': // Open selected item
                    e.preventDefault();
                    openSelectedItem();
                    break;
                case ' ': // Toggle selection (Space)
                    e.preventDefault();
                    toggleCurrentSelection();
                    break;
            }
        }

        function selectAllItems() {
            const selectAllCheckbox = document.getElementById('selectAll');
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = true;
                toggleSelectAll();
            }
        }

        function deselectAllItems() {
            const selectAllCheckbox = document.getElementById('selectAll');
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = false;
                toggleSelectAll();
            }
            selectedItemIndex = -1;
            clearHighlights();
        }

        function navigateItems(direction) {
            if (itemRows.length === 0) return;

            // Clear previous highlight
            clearHighlights();

            // Update index
            selectedItemIndex += direction;
            if (selectedItemIndex < 0) selectedItemIndex = 0;
            if (selectedItemIndex >= itemRows.length) selectedItemIndex = itemRows.length - 1;

            // Highlight current row
            const currentRow = itemRows[selectedItemIndex];
            if (currentRow) {
                currentRow.row.classList.add('table-active');
                currentRow.row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function clearHighlights() {
            itemRows.forEach(item => {
                item.row.classList.remove('table-active');
            });
        }

        function toggleCurrentSelection() {
            if (selectedItemIndex >= 0 && selectedItemIndex < itemRows.length) {
                const currentItem = itemRows[selectedItemIndex];
                currentItem.checkbox.checked = !currentItem.checkbox.checked;
                updateBulkActions();
            }
        }

        function openSelectedItem() {
            if (selectedItemIndex >= 0 && selectedItemIndex < itemRows.length) {
                const currentRow = itemRows[selectedItemIndex].row;
                const link = currentRow.querySelector('a[href*="Index"]');
                if (link) {
                    link.click();
                }
            }
        }

        function showKeyboardShortcuts() {
            const modal = new bootstrap.Modal(document.getElementById('keyboardShortcutsModal'));
            modal.show();
        }

        // Initialize keyboard shortcuts when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeKeyboardShortcuts);
        } else {
            initializeKeyboardShortcuts();
        }
    </script>

    <style>
        .drop-zone {
            border: 3px dashed #ccc;
            border-radius: 10px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background-color: #f8f9fa;
        }

        .drop-zone:hover {
            border-color: #007bff;
            background-color: #e7f1ff;
        }

        .drop-zone.drag-over {
            border-color: #28a745;
            background-color: #d4edda;
        }

        .drop-zone-content i {
            color: #6c757d;
        }

        .upload-progress {
            padding: 20px;
        }

        .bulk-actions-toolbar {
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .item-row {
            transition: background-color 0.2s;
        }

        .item-checkbox:checked + .item-row,
        .item-row:has(.item-checkbox:checked) {
            background-color: #e7f1ff !important;
        }

        .table-active {
            background-color: #fff3cd !important;
            border-left: 3px solid #ffc107 !important;
        }

        kbd {
            padding: 2px 6px;
            font-size: 11px;
            color: #fff;
            background-color: #333;
            border-radius: 3px;
            box-shadow: inset 0 -1px 0 rgba(0,0,0,.25);
            font-family: monospace;
        }
    </style>
}

